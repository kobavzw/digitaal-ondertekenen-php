{
  "name": "koba/digitaal-ondertekenen-php",
  "description": "PHP wrapper for the Vlaamse overheid Digitaal Ondertekenen API.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Wouter Henderickx",
      "email": "wouter.henderickx@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Koba\\DigitaalOndertekenen\\": "src/DigitaalOndertekenen/"
    }
  },
  "require": {
    "php": "^8.1",
    "php-http/discovery": "^1.20",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "league/oauth2-client": "^2.9",
    "json-mapper/json-mapper": "^2.25"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2"
  }
}
